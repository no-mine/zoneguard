# Generic .deb build environment for Debian. Same approach as
# Containerfile.ubuntu: real build dependencies come from
# packaging/debian/control via mk-build-deps, not hardcoded here.
FROM debian:12

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        debhelper \
        dh-python \
        devscripts \
        equivs \
        python3-all \
        python3-setuptools \
        ca-certificates \
        tar \
        gzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /build
WORKDIR /src
